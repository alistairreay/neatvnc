diff --git a/src/auth/vnc-auth.c b/src/auth/vnc-auth.c
new file mode 100644
index 0000000..d58da4e
--- /dev/null
+++ b/src/auth/vnc-auth.c
@@ -0,0 +1,105 @@
+/*
